# Copy to .env for local dev (do not commit the real .env)

GOOGLE_API_KEY=your-gemini-api-key-from-aistudio.google.com
LLM_MODEL=gemini-3.1-flash-lite

# --- Google Sheets/Drive auth: use ONE of the following two options ---

# Option A (recommended): OAuth as your own Google account. Required for
# creating new sheets, since service accounts have zero Drive storage quota
# on personal (non-Workspace) accounts. Run get_token.py once to generate
# this file -- see that script's docstring for setup steps.
GOOGLE_OAUTH_TOKEN_JSON=./token.json

# Option B: service account (fallback). Works for reading/writing sheets
# that already exist and are shared with it, but generally cannot create
# new sheets due to the quota limitation above. Only used if
# GOOGLE_OAUTH_TOKEN_JSON above is not set.
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# Tab name used within every class sheet (usually fine to leave as default)
GOOGLE_WORKSHEET_NAME=Sheet1

# Optional: only relevant when using the service account (Option B). If
# set, newly created class sheets are shared with this email as an editor,
# so you can view/edit them directly in Google Sheets too. Not needed with
# OAuth (Option A), since you already own the files directly.
GOOGLE_SHARE_EMAIL=you@example.com

# Optional: a Google Drive folder ID to keep all class sheets in one place.
# If left unset, the app automatically creates (or reuses) a folder named
# "Homework Tracker" the first time it's needed -- you don't need to create
# one yourself. Only set this if you want to point at a specific existing
# folder instead. Get the ID from the folder's URL:
# drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=

# --- Restrict app access to your own Google account ---
# All three must be set for login to be enforced; if any is missing, the
# app is open to anyone with the URL (fine for local dev, NOT for a public
# Cloud Run deployment).

# The email address allowed to sign in -- only this exact address gets in.
ALLOWED_EMAIL=you@gmail.com

# A random secret used to sign the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# OAuth "Web application" client ID (different from the Desktop one used by
# get_token.py). Create one in Cloud Console: APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Application type: Web
# application. Add both http://localhost:8000 and your eventual Cloud Run
# URL under "Authorized JavaScript origins". This value is safe to expose
# publicly (it's embedded in the login page), unlike the other secrets here.
GOOGLE_OAUTH_WEB_CLIENT_ID=
